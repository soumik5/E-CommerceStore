              "Name": "ecommerce-docker-server"
            },
            "tags_all": {
              "Name": "ecommerce-docker-server"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\n\nset -e\n\necho \"======================================\"\necho \"Starting Ecommerce Server Setup\"\necho \"======================================\"\n\n# Update packages\ndnf update -y\n\n# Install Docker\ndnf install -y docker\n\n# Start Docker\nsystemctl start docker\nsystemctl enable docker\n\n# Allow ec2-user to use Docker\nusermod -aG docker ec2-user\n\necho \"Docker installed successfully\"\n\n# Wait for Docker\nsleep 10\n\n# Pull Docker images\necho \"Pulling frontend image...\"\ndocker pull soumik5/e-commercestore-frontend:v1\n\necho \"Pulling user service image...\"\ndocker pull soumik5/e-commercestore-user-service:v1\n\necho \"Pulling product service image...\"\ndocker pull soumik5/e-commercestore-product-service:v1\n\necho \"Pulling order service image...\"\ndocker pull soumik5/e-commercestore-order-service:v1\n\necho \"Pulling cart service image...\"\ndocker pull soumik5/e-commercestore-cart-service:v1\n\necho \"All images pulled successfully\"\n\n# Create Docker network\ndocker network create ecommerce-network || true\n\n# ---------------------------------------------------------\n# User Service\n# ---------------------------------------------------------\n\ndocker rm -f user-service 2\u003e/dev/null || true\n\ndocker run -d \\\n  --name user-service \\\n  --network ecommerce-network \\\n  -p 3001:3001 \\\n  soumik5/e-commercestore-user-service:v1\n\n# ---------------------------------------------------------\n# Product Service\n# ---------------------------------------------------------\n\ndocker rm -f product-service 2\u003e/dev/null || true\n\ndocker run -d \\\n  --name product-service \\\n  --network ecommerce-network \\\n  -p 3002:3002 \\\n  soumik5/e-commercestore-product-service:v1\n\n# ---------------------------------------------------------\n# Order Service\n# ---------------------------------------------------------\n\ndocker rm -f order-service 2\u003e/dev/null || true\n\ndocker run -d \\\n  --name order-service \\\n  --network ecommerce-network \\\n  -p 3003:3003 \\\n  soumik5/e-commercestore-order-service:v1\n\n# ---------------------------------------------------------\n# Cart Service\n# ---------------------------------------------------------\n\ndocker rm -f cart-service 2\u003e/dev/null || true\n\ndocker run -d \\\n  --name cart-service \\\n  --network ecommerce-network \\\n  -p 3004:3004 \\\n  soumik5/e-commercestore-cart-service:v1\n\n# ---------------------------------------------------------\n# Frontend\n# ---------------------------------------------------------\n\ndocker rm -f frontend 2\u003e/dev/null || true\n\ndocker run -d \\\n  --name frontend \\\n  --network ecommerce-network \\\n  -p 3000:3000 \\\n  soumik5/e-commercestore-frontend:v1\n\necho \"======================================\"\necho \"All containers started\"\necho \"======================================\"\n\n# Show running containers\ndocker ps",
